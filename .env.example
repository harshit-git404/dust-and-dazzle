# ==============================================================================
# Dust and Dazzle — Environment Variables Configuration
# ==============================================================================

# Supabase Public API URL (from Supabase Project Settings > API)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co

# Supabase Anonymous Public API Key (safe for client-side queries)
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# Supabase Service Role Key (CONFIDENTIAL: ONLY used in server-side API routes & server actions)
# NEVER expose this key in client-side code or public repositories!
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# Author Primary Email (used to verify the sole author login in Phase 2)
AUTHOR_EMAIL=author@example.com

# Site URL
NEXT_PUBLIC_SITE_URL=http://localhost:3000

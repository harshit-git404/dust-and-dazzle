# ==============================================================================
# Dust and Dazzle — Environment Variables Configuration
# ==============================================================================

# Supabase Public API URL (from Supabase Dashboard > Project Settings > API)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co

# Supabase Anonymous Public API Key (safe for client-side and public RLS queries)
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# Site Base URL (used for canonical URLs, Open Graph previews, and redirects)
NEXT_PUBLIC_SITE_URL=https://dustanddazzle.vercel.app

# Search Engine Indexing Toggle (default: false to block search bots; set to true when ready for public SEO)
SITE_INDEXABLE=false

# Secret Salt for Reader Comment IP Rate-Limiter Hashing (prevents rainbow table attacks)
IP_HASH_SALT=your-random-secret-salt-string-here

# ------------------------------------------------------------------------------
# EMAIL NOTIFICATIONS (READER COMMENT ALERTS)
# ------------------------------------------------------------------------------
# SMTP Host server (e.g., smtp.gmail.com, smtp.resend.com, mail.example.com)
SMTP_HOST=smtp.example.com

# SMTP Port (587 for TLS, 465 for SSL)
SMTP_PORT=587

# SMTP Authentication Username / Email
SMTP_USER=your-smtp-username-or-email

# SMTP Authentication Password / App Password
SMTP_PASS=your-smtp-password

# Notification recipient(s) for reader comment alerts (comma-separated if multiple)
NOTIFY_TO=author@example.com

# Site URL for links in email notifications (optional fallback to NEXT_PUBLIC_SITE_URL)
SITE_URL=https://dust-and-dazzle.vercel.app

# ------------------------------------------------------------------------------
# PHASE 6 "HEIRLOOM" PUBLIC FEATURE FLAGS (Default to false in production)
# ------------------------------------------------------------------------------
NEXT_PUBLIC_FEATURE_READER_TOOLS=false
NEXT_PUBLIC_FEATURE_SEARCH=false
NEXT_PUBLIC_FEATURE_AUDIO=false
NEXT_PUBLIC_FEATURE_INSTALL=false
NEXT_PUBLIC_FEATURE_READ_COUNTS=false
NEXT_PUBLIC_FEATURE_TIMELINE=false

# ------------------------------------------------------------------------------
# LOCAL & CI CLI SCRIPTS ONLY (DO NOT ADD TO VERCEL DEPLOYMENT ENVIRONMENT)
# ------------------------------------------------------------------------------
# Supabase Service Role Key (used ONLY for local offline CLI scripts and GitHub Actions automated backup)
# NEVER set this in Vercel or expose it in client runtime code!
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# Automated CI export override (only set inside GitHub Actions backup workflow)
ALLOW_READONLY_EXPORT_IN_CI=0


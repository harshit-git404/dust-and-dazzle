# ==============================================================================
# Dust and Dazzle — Environment Variables Configuration
# ==============================================================================

# Supabase Public API URL (from Supabase Dashboard > Project Settings > API)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co

# Supabase Anonymous Public API Key (safe for client-side and public RLS queries)
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# Site Base URL (used for canonical URLs, Open Graph previews, and redirects)
NEXT_PUBLIC_SITE_URL=https://dustanddazzle.vercel.app

# Search Engine Indexing Toggle (default: false to block search bots; set to true when ready for public SEO)
SITE_INDEXABLE=false

# Secret Salt for Reader Comment IP Rate-Limiter Hashing (prevents rainbow table attacks)
IP_HASH_SALT=your-random-secret-salt-string-here

# ------------------------------------------------------------------------------
# LOCAL CLI SCRIPTS ONLY (DO NOT ADD TO VERCEL DEPLOYMENT ENVIRONMENT)
# ------------------------------------------------------------------------------
# Supabase Service Role Key (used ONLY for local offline CLI scripts: import-stories, publish-all)
# NEVER set this in Vercel or expose it in runtime code!
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here
